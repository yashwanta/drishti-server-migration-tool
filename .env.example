# DRISHTI HyperShift environment example.
# Copy to .env and edit. NEVER commit .env or real credentials.

# Deployment mode: mock (default, no real infra), lab, production
DRISHTI_MODE=mock
# Explicit lab-only mutation interlock. Keep false until read-only preflight passes.
DRISHTI_ENABLE_LAB_MIGRATION=false

# API server
DRISHTI_HTTP_ADDR=:8080
DRISHTI_LOG_LEVEL=info
DRISHTI_READ_TIMEOUT=15s
DRISHTI_WRITE_TIMEOUT=30s

# Authentication is mandatory. In mock mode this protected bcrypt file seeds
# the in-memory user store. In lab/live/production it is imported only when the
# PostgreSQL auth_users table is empty; PostgreSQL is authoritative afterward.
DRISHTI_AUTH_USERS_FILE=/run/secrets/drishti-auth-users.json
# Docker Compose host path mounted read-only for mock/first-run bootstrap.
DRISHTI_AUTH_USERS_HOST_FILE=./secrets/drishti-auth-users.json
DRISHTI_SESSION_TTL=8h
# Set true behind HTTPS. Live and production modes refuse to start otherwise.
DRISHTI_SESSION_SECURE=false
# Optional credentialed CORS origin; omit for a same-origin UI.
# DRISHTI_ALLOWED_ORIGIN=https://drishti.example.com

# Database (required for lab/production modes)
# DRISHTI_DB_URL=postgres://hypershift:CHANGE_ME@localhost:5432/hypershift?sslmode=disable

# Migration worker
DRISHTI_WORKER_ADDR=:8090
DRISHTI_WORKSPACE_ROOT=/tmp/hypershift-workspace

# Proxmox lab connection probes. Secret Reference "lpclab-source" maps
# to DRISHTI_SECRET_LPCLAB_SOURCE_*, and "lpclab-target" maps similarly.
# DRISHTI_SECRET_LPCLAB_SOURCE_TOKEN_ID=drishti@pve!hypershift
# DRISHTI_SECRET_LPCLAB_SOURCE_TOKEN_SECRET=replace-with-source-token-secret
# DRISHTI_SECRET_LPCLAB_TARGET_TOKEN_ID=drishti@pve!hypershift
# DRISHTI_SECRET_LPCLAB_TARGET_TOKEN_SECRET=replace-with-target-token-secret
