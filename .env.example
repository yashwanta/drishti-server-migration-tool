# DRISHTI HyperShift environment example.
# Copy to .env and edit. NEVER commit .env or real credentials.

# Deployment mode: mock (default, no real infra), lab, production
DRISHTI_MODE=mock

# API server
DRISHTI_HTTP_ADDR=:8080
DRISHTI_LOG_LEVEL=info
DRISHTI_READ_TIMEOUT=15s
DRISHTI_WRITE_TIMEOUT=30s

# Database (required for lab/production modes)
# DRISHTI_DB_URL=postgres://hypershift:CHANGE_ME@localhost:5432/hypershift?sslmode=disable

# Migration worker
DRISHTI_WORKER_ADDR=:8090
DRISHTI_WORKSPACE_ROOT=/tmp/hypershift-workspace